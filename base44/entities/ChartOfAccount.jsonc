{
  "name": "ChartOfAccount",
  "type": "object",
  "properties": {
    "account_number": {
      "type": "string",
      "description": "Account number (e.g. 1000, 2000)"
    },
    "name": {
      "type": "string",
      "description": "Account name"
    },
    "type": {
      "type": "string",
      "enum": [
        "asset",
        "liability",
        "equity",
        "revenue",
        "expense"
      ],
      "description": "Account type"
    },
    "sub_type": {
      "type": "string",
      "description": "Sub-category (e.g. Current Asset, Fixed Asset)"
    },
    "balance": {
      "type": "number",
      "default": 0,
      "description": "Current balance"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "account_number",
    "name",
    "type"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}