{
  "name": "Applicant",
  "type": "object",
  "properties": {
    "application_number": {
      "type": "string"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date"
    },
    "gender": {
      "type": "string",
      "enum": [
        "male",
        "female",
        "other",
        "prefer_not_to_say"
      ]
    },
    "nationality": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "national_id": {
      "type": "string"
    },
    "high_school_name": {
      "type": "string"
    },
    "high_school_graduation_year": {
      "type": "string"
    },
    "high_school_gpa": {
      "type": "number"
    },
    "desired_programme_id": {
      "type": "string"
    },
    "desired_programme_name": {
      "type": "string"
    },
    "desired_intake_year": {
      "type": "string"
    },
    "application_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "under_review",
        "shortlisted",
        "accepted",
        "rejected",
        "waitlisted",
        "enrolled"
      ],
      "default": "submitted"
    },
    "interview_date": {
      "type": "string",
      "format": "date"
    },
    "interview_score": {
      "type": "number"
    },
    "admission_score": {
      "type": "number"
    },
    "rejection_reason": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "documents_submitted": {
      "type": "boolean",
      "default": false
    },
    "contact_id": {
      "type": "string",
      "description": "Linked Contact record (CRM lead/prospect)"
    },
    "opportunity_id": {
      "type": "string",
      "description": "Linked Opportunity record (application pipeline)"
    }
  },
  "required": [
    "first_name",
    "last_name",
    "email"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}