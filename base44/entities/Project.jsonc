{
  "name": "Project",
  "type": "object",
  "properties": {
    "project_number": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "manager_id": {
      "type": "string"
    },
    "manager_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "planning",
        "open",
        "in_progress",
        "completed",
        "cancelled",
        "on_hold"
      ],
      "default": "planning"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "budget": {
      "type": "number",
      "default": 0
    },
    "actual_cost": {
      "type": "number",
      "default": 0
    },
    "billed_amount": {
      "type": "number",
      "default": 0
    },
    "percent_complete": {
      "type": "number",
      "default": 0
    },
    "billing_type": {
      "type": "string",
      "enum": [
        "fixed_price",
        "time_and_material",
        "not_billable"
      ],
      "default": "time_and_material"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}