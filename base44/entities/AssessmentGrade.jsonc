{
  "name": "AssessmentGrade",
  "type": "object",
  "properties": {
    "assessment_id": {
      "type": "string"
    },
    "assessment_title": {
      "type": "string"
    },
    "assessment_type": {
      "type": "string"
    },
    "student_id": {
      "type": "string"
    },
    "student_name": {
      "type": "string"
    },
    "student_number": {
      "type": "string"
    },
    "course_id": {
      "type": "string"
    },
    "course_code": {
      "type": "string"
    },
    "enrollment_id": {
      "type": "string"
    },
    "marks_obtained": {
      "type": "number"
    },
    "total_marks": {
      "type": "number"
    },
    "percentage": {
      "type": "number"
    },
    "submission_date": {
      "type": "string",
      "format": "date"
    },
    "graded_date": {
      "type": "string",
      "format": "date"
    },
    "feedback": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_submitted",
        "submitted",
        "graded",
        "late"
      ],
      "default": "not_submitted"
    }
  },
  "required": [
    "assessment_id",
    "student_id"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}