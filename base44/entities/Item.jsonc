{
  "name": "Item",
  "type": "object",
  "properties": {
    "item_number": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "inventory",
        "service",
        "non_inventory"
      ],
      "default": "inventory"
    },
    "unit_of_measure": {
      "type": "string",
      "default": "PCS"
    },
    "unit_price": {
      "type": "number",
      "default": 0
    },
    "unit_cost": {
      "type": "number",
      "default": 0
    },
    "quantity_on_hand": {
      "type": "number",
      "default": 0
    },
    "reorder_point": {
      "type": "number",
      "default": 0
    },
    "reorder_quantity": {
      "type": "number",
      "default": 0
    },
    "warehouse": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "tax_group": {
      "type": "string"
    },
    "barcode": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "manual",
        "programme",
        "course"
      ],
      "default": "manual",
      "description": "Whether this item was created manually or synced from a Programme or Course"
    },
    "source_id": {
      "type": "string",
      "description": "ID of the linked Programme or Course record"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}